<div class="row mb-4">
    <div class="col">
        <div class="message">
            <div class="alert alert-info" role="alert">
                {{#str}}class_notes_intro, block_design_ideas{{/str}}
            </div>

            <!-- Select all checkbox -->
            <div class="form-check mb-3">
                <input type="checkbox"
                       class="form-check-input"
                       id="block-design-ideas-subject-select-all">
                <label class="form-check-label" for="block-design-ideas-subject-select-all">
                    {{#str}}select_all, block_design_ideas{{/str}}
                </label>
            </div>

            <ul class="list-group">
                {{#data}}
                    <li class="list-group-item">
                        <div class="form-check">
                            <input type="checkbox"
                                   class="form-check-input block-design-ideas-subject-select"
                                   data-name="{{name}}"
                                   id="subject-{{@index}}">
                            <label class="form-check-label" for="subject-{{@index}}">
                                {{name}}
                            </label>
                        </div>
                    </li>
                {{/data}}
            </ul>
        </div>
        <div class="mt-2">
            <div class="btn-group float-right" role="group">
                <button
                        id="btn-create-class-notes"
                        type="button"
                        class="btn btn-outline-primary block-design-ideas-btn-create-class-notes"
                        data-section="{{section}}"
                        data-course_id="{{course_id}}">
                    {{#str}}create_class_notes_for_topic, block_design_ideas{{/str}}
                </button>
            </div>
        </div>
    </div>
</div>