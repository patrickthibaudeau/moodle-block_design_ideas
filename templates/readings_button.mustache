<div id="btn-design_ideas-topics" class=" btn-group mt-2 w-100" role="group">
    <button id="btnClassnotesGroupDrop1" type="button" class="btn btn-outline-info dropdown-toggle"
            data-toggle="dropdown" aria-expanded="false">
        {{#str}}readings, block_design_ideas{{/str}}
    </button>
    <div class="dropdown-menu" style="background-color: white; color: black;">
        <div class="dropdown-item">
            <div class="alert alert-warning ml-1 mr-1 mb-0">
                {{#str}}readings_help, block_design_ideas{{/str}}
            </div>
        </div>
        {{#buttons}}
            <div class="dropdown-item" style="background-color: white;">
                <a href="#"
                   class="block-design-ideas-btn-ai-call-class-notes"
                   data-prompt_id="{{promptid}}"
                   data-topic_id="{{topicid}}"
                   data-course_id="{{courseid}}"
                   style="color: black; text-decoration: none;"
                   onmouseover="this.style.backgroundColor='#e9ecef'; this.style.color='black'; this.parentElement.style.backgroundColor='#e9ecef'"
                   onmouseout="this.style.backgroundColor=''; this.style.color='black'; this.parentElement.style.backgroundColor='white'">
                    {{topic_name}}
                </a>
            </div>
        {{/buttons}}
    </div>
</div>
